---
// iPhone and iPad (Safari): there's no "Install" button like on Android, so a
// small card explains how to add Relax&Bite to the home screen. Shown once
// after a few seconds; "Not now" hides it for two weeks. Never shown inside
// the Android app or once it's already on the home screen.
---

<div data-ios-install hidden class="fixed inset-x-3 z-[55] bottom-[calc(5rem+var(--sab))] md:hidden">
  <div class="rounded-2xl bg-surface border border-line shadow-[0_12px_32px_-8px_var(--shadow-strong)] p-4">
    <div class="flex items-start gap-3">
      <img src="/icons/apple-touch-icon.png" alt="" width="48" height="48" class="size-12 rounded-xl shrink-0" />
      <div class="flex-1 min-w-0">
        <p class="font-extrabold">Get the Relax&amp;Bite app</p>
        <p class="text-sm text-muted mt-0.5 leading-snug">
          Tap
          <svg class="inline -mt-1 text-[#0a84ff]" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-label="Share"><path d="M12 3v12M8 7l4-4 4 4" /><path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7" /></svg>
          <strong class="text-ink">Share</strong> below, then <strong class="text-ink">Add to Home Screen</strong>. It opens full screen, like an app, and can send you order updates.
        </p>
      </div>
      <button type="button" data-ios-close class="icon-btn border-0 -mr-2 -mt-2 shrink-0" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </div>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-ios-install]');
  const KEY = 'rb_ios_install_later';
  const root = document.documentElement;
  const ua = navigator.userAgent;
  // iPhone/iPad Safari only (iPads can report a Mac; they have touch)
  const ios = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
  const safari = /Safari/.test(ua) && !/CriOS|FxiOS|EdgiOS|OPiOS/.test(ua);
  const installed = root.classList.contains('pwa') || root.classList.contains('in-app');
  let snoozed = false;
  try {
    snoozed = Number(localStorage.getItem(KEY) || 0) > Date.now();
  } catch {
    /* storage unavailable: show it */
  }
  if (box && ios && safari && !installed && !snoozed) {
    window.setTimeout(() => {
      box.hidden = false;
      box.animate?.([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
    }, 4000);
    box.querySelector('[data-ios-close]')?.addEventListener('click', () => {
      box.hidden = true;
      try {
        localStorage.setItem(KEY, String(Date.now() + 14 * 864e5));
      } catch {
        /* fine */
      }
    });
  }
</script>
