---

<svg
  width={size}
  height={size}
  style={`width:${size / 16}rem;height:${size / 16}rem`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
><Fragment set:html={paths[name]} /></svg>
