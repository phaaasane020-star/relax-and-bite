---
// Withdrawals from restaurant and rider wallets. Send the MoMo yourself, then
// mark it sent (with the MoMo transaction ID). Rejecting puts the money back
// in their wallet.
import PanelLayout from '../../layouts/PanelLayout.astro';
import Alert from '../../components/panel/Alert.astro';
import ReasonDialog from '../../components/panel/ReasonDialog.astro';
import Icon from '../../components/Icon.astro';
import { audit } from '../../data/store';
import { listWithdrawals, markWithdrawalPaid, NETWORK_LABEL, rejectWithdrawal } from '../../data/wallet';
import { notifyWithdrawalDecided } from '../../data/notify';
import { field, flash, takeFlash } from '../../lib/actions';
import { clientInfo } from '../../lib/client-info';
import { dateTime, money, prettyPhone } from '../../lib/format';

const me = Astro.locals.partner!;
const who = `${me.full_name} (admin)`;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = field(form, 'action');
  const id = Number(field(form, 'id'));
  try {
    if (action === 'paid') {
      const w = await markWithdrawalPaid(id, me.full_name, field(form, 'note', 120));
      await audit(who, `Sent a withdrawal of ${money(Number(w.payout))} to ${prettyPhone(w.momo_number)}${w.note ? ` (MoMo ID ${w.note})` : ''}`, { kind: 'admin', ...clientInfo(Astro) });
      await notifyWithdrawalDecided(w.account_id, w.role, true, Number(w.payout), w.note);
      flash(Astro.cookies, `Marked as sent. ${prettyPhone(w.momo_number)} has been told.`);
    } else if (action === 'reject') {
      const w = await rejectWithdrawal(id, me.full_name, field(form, 'reason', 200));
      await audit(who, `Didn't send a withdrawal of ${money(Number(w.payout))} to ${prettyPhone(w.momo_number)}: ${w.note}`, { kind: 'admin', severity: 'warning', ...clientInfo(Astro) });
      await notifyWithdrawalDecided(w.account_id, w.role, false, Number(w.payout), w.note);
      flash(Astro.cookies, 'Rejected. The money is back in their wallet and they have been told why.');
    }
    return Astro.redirect('/admin/payouts', 303);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Something went wrong. Try again.';
  }
}

const [waiting, done] = await Promise.all([listWithdrawals('requested'), listWithdrawals('done')]);
const success = takeFlash(Astro.cookies);
const totalToSend = waiting.reduce((s, w) => s + w.payout, 0);
const fees = done.filter((w) => w.status === 'paid').reduce((s, w) => s + w.fee, 0);
---

<PanelLayout title="Payouts">
  <div class="max-w-4xl">
    <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Payouts</h1>
    <p class="text-sm text-muted mt-1">Restaurants and riders asking to withdraw. Send the Mobile Money, then mark it sent.</p>
    <div class="mt-5"><Alert error={error} success={success} /></div>

    <dl class="grid grid-cols-2 gap-3">
      <div class="card p-4"><dt class="text-sm font-semibold text-muted">To send now</dt><dd class="text-2xl font-extrabold tabular">{money(totalToSend)}</dd><dd class="text-[0.8125rem] text-muted">{waiting.length} {waiting.length === 1 ? 'request' : 'requests'}</dd></div>
      <div class="card p-4"><dt class="text-sm font-semibold text-muted">Fees kept (recent)</dt><dd class="text-2xl font-extrabold tabular">{money(fees)}</dd><dd class="text-[0.8125rem] text-muted">From the payouts below</dd></div>
    </dl>

    <h2 class="section-title text-lg font-extrabold mt-8 mb-3">Waiting to be sent</h2>
    {
      waiting.length === 0 ? (
        <p class="text-sm text-muted">Nothing to send right now.</p>
      ) : (
        <ul class="flex flex-col gap-3">
          {waiting.map((w) => (
            <li class="card p-4 sm:p-5 flex flex-col gap-4">
              <div class="flex items-start gap-3">
                <span class:list={['size-10 rounded-xl flex items-center justify-center shrink-0', w.role === 'vendor' ? 'bg-brand-soft text-brand' : 'bg-success-soft text-success']}>
                  <Icon name={w.role === 'vendor' ? 'store' : 'bike'} size={20} />
                </span>
                <div class="flex-1 min-w-0">
                  <p class="font-bold">{w.business ?? w.full_name}</p>
                  <p class="text-sm text-muted">{w.business ? `${w.full_name} · ` : ''}{w.role === 'vendor' ? 'Restaurant' : 'Rider'} · asked {dateTime(w.created_at)}</p>
                </div>
                <div class="text-right">
                  <p class="text-xl font-extrabold tabular">{money(w.payout)}</p>
                  <p class="text-[0.8125rem] text-muted tabular">{money(w.amount)} − {money(w.fee)} fee</p>
                </div>
              </div>
              <div class="rounded-xl bg-fill px-4 py-3 flex flex-wrap items-center justify-between gap-2">
                <span class="text-sm">Send to <strong>{NETWORK_LABEL[w.momo_network]}</strong></span>
                <span class="font-extrabold tabular text-lg" data-copy={w.momo_number}>{prettyPhone(w.momo_number)}</span>
              </div>
              <div class="flex flex-col sm:flex-row gap-2">
                <form method="post" class="flex-1 flex gap-2">
                  <input type="hidden" name="action" value="paid" />
                  <input type="hidden" name="id" value={w.id} />
                  <input name="note" class="field-input flex-1 min-w-0" placeholder="MoMo transaction ID (optional)" maxlength="120" />
                  <button type="submit" class="btn btn-primary shrink-0">Mark as sent</button>
                </form>
                <button type="button" class="btn btn-secondary text-danger" data-reason-open="reject-dialog" data-id={w.id} data-name={w.business ?? w.full_name}>Reject</button>
              </div>
            </li>
          ))}
        </ul>
      )
    }

    <h2 class="section-title text-lg font-extrabold mt-8 mb-3">Done</h2>
    {
      done.length === 0 ? (
        <p class="text-sm text-muted">No payouts yet.</p>
      ) : (
        <div class="card overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-paper text-left text-muted">
              <tr>
                <th class="px-4 py-3 font-semibold">Who</th>
                <th class="px-4 py-3 font-semibold">Sent to</th>
                <th class="px-4 py-3 font-semibold text-right">Amount</th>
                <th class="px-4 py-3 font-semibold">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-line">
              {done.map((w) => (
                <tr>
                  <td class="px-4 py-3"><span class="font-semibold">{w.business ?? w.full_name}</span><br /><span class="text-muted">{w.decided_at ? dateTime(w.decided_at) : ''}</span></td>
                  <td class="px-4 py-3 tabular">{NETWORK_LABEL[w.momo_network]} {prettyPhone(w.momo_number)}</td>
                  <td class="px-4 py-3 text-right tabular font-bold">{money(w.payout)}</td>
                  <td class="px-4 py-3">
                    <span class:list={['badge h-6 text-xs', w.status === 'paid' ? 'bg-success-soft text-success' : 'bg-fill text-ink-soft']}>{w.status === 'paid' ? 'Sent' : 'Rejected'}</span>
                    {w.note && <span class="block text-[0.8125rem] text-muted mt-1">{w.note}</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </div>
  <ReasonDialog id="reject-dialog" action="reject" title="Reject withdrawal" confirmLabel="Reject" hint="They'll see this. The money goes back into their wallet." placeholder="For example, the MoMo number is wrong" />
</PanelLayout>
