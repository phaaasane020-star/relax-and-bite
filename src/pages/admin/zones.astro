---
import { clientInfo } from '../../lib/client-info';
import PanelLayout from '../../layouts/PanelLayout.astro';
import Alert from '../../components/panel/Alert.astro';
import { audit, getAllZones, saveZone } from '../../data/store';
import { field, flash, num, takeFlash } from '../../lib/actions';

let error = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = field(form, 'action');
  const idRaw = field(form, 'id');
  const who = `${Astro.locals.partner!.full_name} (admin)`;
  try {
    if (action === 'zone') {
      await saveZone({
        id: idRaw ? Number(idRaw) : undefined,
        name: field(form, 'name', 60),
        region: field(form, 'region', 60),
        delivery_fee: num(form, 'delivery_fee'),
        is_active: form.get('is_active') === 'yes',
        lat: field(form, 'lat') ? num(form, 'lat') : null,
        lng: field(form, 'lng') ? num(form, 'lng') : null,
        radius_km: num(form, 'radius_km') || 5,
      });
      await audit(who, `${idRaw ? 'Updated' : 'Added'} town ${field(form, 'name', 60)}`, clientInfo(Astro));
      flash(Astro.cookies, idRaw ? 'Town updated.' : 'Town added.');
    }
    return Astro.redirect('/admin/zones', 303);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Could not save. Try again.';
  }
}

const zones = await getAllZones();
const regions = [...new Set(zones.map((z) => z.region))];
const success = takeFlash(Astro.cookies);
---

<PanelLayout title="Delivery areas">
  <Alert error={error} success={success} />
  <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Delivery areas</h1>
  <p class="text-sm text-muted mt-1">
    The towns you deliver to. Tick "Delivering here" to open a town. Customers only see towns that are open.
  </p>

  <div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px] items-start">
    <div class="flex flex-col gap-5">
      {
        regions.map((region) => (
          <>
          <h2 class="text-sm font-bold text-muted -mb-2">{region} Region</h2>
          {zones.filter((z) => z.region === region).map((z) => {
          return (
            <section class="card" aria-label={z.name}>
              <form method="post" class="p-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)] lg:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)_auto_auto] items-end">
                <input type="hidden" name="action" value="zone" />
                <input type="hidden" name="id" value={z.id} />
                <div>
                  <label class="field-label" for={`name-${z.id}`}>Town</label>
                  <input id={`name-${z.id}`} name="name" class="field-input font-bold" value={z.name} required />
                </div>
                <div>
                  <label class="field-label" for={`region-${z.id}`}>Region</label>
                  <input id={`region-${z.id}`} name="region" class="field-input" value={z.region} required />
                </div>
                <input type="hidden" name="delivery_fee" value={z.delivery_fee} />
                <label class="flex items-center gap-2 text-sm font-semibold min-h-[2.875rem]">
                  <input type="checkbox" name="is_active" value="yes" checked={z.is_active} class="size-5 rounded text-brand border-line-strong focus:ring-brand" />
                  Delivering here
                </label>
                <button type="submit" class="btn btn-secondary">Save</button>
                <details class="sm:col-span-full">
                  <summary class="text-sm font-semibold text-brand w-fit">
                    Where it is on the map {z.lat === null ? <span class="text-warning-ink">(not set yet)</span> : <span class="text-muted font-medium">(set)</span>}
                  </summary>
                  <div class="grid gap-3 sm:grid-cols-3 mt-3">
                    <div>
                      <label class="field-label" for={`lat-${z.id}`}>Latitude</label>
                      <input id={`lat-${z.id}`} name="lat" type="number" step="0.0001" class="field-input tabular" value={z.lat ?? ''} placeholder="5.5811" />
                    </div>
                    <div>
                      <label class="field-label" for={`lng-${z.id}`}>Longitude</label>
                      <input id={`lng-${z.id}`} name="lng" type="number" step="0.0001" class="field-input tabular" value={z.lng ?? ''} placeholder="-0.9944" />
                    </div>
                    <div>
                      <label class="field-label" for={`rad-${z.id}`}>Radius (km)</label>
                      <input id={`rad-${z.id}`} name="radius_km" type="number" min="1" max="50" step="0.5" class="field-input tabular" value={z.radius_km} />
                    </div>
                  </div>
                  <p class="field-hint">Copy the town centre from Google Maps (right-click, then the numbers at the top). The radius is how far from the centre you deliver.</p>
                </details>
              </form>

            </section>
          );
          })}
          </>
        ))
      }
    </div>

    <aside class="card p-5 flex flex-col gap-4 xl:sticky xl:top-8">
      <h2 class="font-extrabold">Add a town</h2>
      <p class="text-sm text-muted -mt-2">Add it switched off, set its map position, then tick "Delivering here" when you're ready to open.</p>
      <form method="post" class="flex flex-col gap-3">
        <input type="hidden" name="action" value="zone" />
        <div>
          <label class="field-label" for="new-name">Town name</label>
          <input id="new-name" name="name" class="field-input" placeholder="For example, Swedru" required />
        </div>
        <div>
          <label class="field-label" for="new-region">Region</label>
          <input id="new-region" name="region" class="field-input" placeholder="For example, Central" required list="region-list" />
          <datalist id="region-list">{regions.map((r) => <option value={r} />)}</datalist>
        </div>
        <input type="hidden" name="delivery_fee" value="0" />
        <label class="flex items-center gap-2 text-sm font-semibold">
          <input type="checkbox" name="is_active" value="yes" class="size-5 rounded text-brand border-line-strong focus:ring-brand" />
          Open for orders now
        </label>
        <button type="submit" class="btn btn-primary">Add town</button>
      </form>
    </aside>
  </div>
</PanelLayout>
