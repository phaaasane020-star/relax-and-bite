---
import { clientInfo } from '../../lib/client-info';
import PanelLayout from '../../layouts/PanelLayout.astro';
import Alert from '../../components/panel/Alert.astro';
import Icon from '../../components/Icon.astro';
import SoundControls from '../../components/panel/SoundControls.astro';
import { audit, createIssue, getAvailableDeliveries, getRiderOrders, ISSUE_CATEGORIES, MAX_CODE_ATTEMPTS, minutesSince, riderAccept, riderDelivered, riderPickedUp } from '../../data/store';
import { SITE } from '../../data/site';
import { getRider, setRiderOnline } from '../../data/partners';
import { field, flash, takeFlash } from '../../lib/actions';
import { money, prettyPhone } from '../../lib/format';

const account = Astro.locals.partner!;
const riderId = account.rider_id!;
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = field(form, 'action');
  const code = field(form, 'code');
  try {
    const rider = (await getRider(riderId))!;
    if (action === 'online') {
      await setRiderOnline(riderId, true);
      flash(Astro.cookies, "You're online. New delivery requests will show below.");
    } else if (action === 'offline') {
      await setRiderOnline(riderId, false);
      flash(Astro.cookies, "You're offline. You won't get new requests.");
    } else if (action === 'accept') {
      if (!rider.is_online) throw new Error('Go online before accepting deliveries.');
      await riderAccept(rider, code);
      flash(Astro.cookies, `${code} is yours. Head to the restaurant.`);
    } else if (action === 'picked_up') {
      await riderPickedUp(riderId, code);
      flash(Astro.cookies, `${code} picked up. The customer can see you're on the way.`);
    } else if (action === 'delivered') {
      await riderDelivered(riderId, code, field(form, 'customer_code', 8));
      flash(Astro.cookies, `${code} delivered. Well done.`);
    } else if (action === 'report') {
      await createIssue({
        order_code: code || null,
        reporter_role: 'rider',
        reporter_name: rider.full_name,
        reporter_phone: rider.phone,
        category: field(form, 'category'),
        message: field(form, 'message', 600),
      });
      flash(Astro.cookies, 'Report sent. Support will call you shortly.');
      await audit(`${account.full_name} (rider)`, `Reported a problem${code ? ` on ${code}` : ''}: ${field(form, 'category')}`, { kind: 'report', severity: 'warning', ...clientInfo(Astro) });
    }
    const what: Record<string, string> = { online: 'Went online', offline: 'Went offline', accept: `Took ${code}`, picked_up: `Picked up ${code}`, delivered: `Delivered ${code}` };
    if (action !== 'report') await audit(`${rider.full_name} (rider)`, what[action] ?? action, { kind: 'delivery', ...clientInfo(Astro) });
    return Astro.redirect('/rider', 303);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Something went wrong. Try again.';
  }
}

const rider = (await getRider(riderId))!;
const { active, done } = await getRiderOrders(riderId);
const available = rider.is_online && active.length < 2 ? await getAvailableDeliveries(rider.zone_id) : [];
const today = new Date().toISOString().slice(0, 10);
// Counted by when it was delivered (an order placed last night and delivered today counts today)
const deliveredAt = (o: (typeof done)[number]) => (o.events.find((e) => e.status === 'delivered')?.at ?? o.created_at).slice(0, 10);
const doneToday = done.filter((o) => o.status === 'delivered' && deliveredAt(o) === today);
const earnedToday = doneToday.reduce((s, o) => s + o.delivery_fee, 0);
const success = takeFlash(Astro.cookies);

// What the page compares between refreshes to raise alerts.
// m: = deliveries assigned to this rider, a: = requests anyone can take
const area = (o: { locality_name: string; zone_name: string }) => o.locality_name || o.zone_name;
const snapshot = JSON.stringify({
  ...Object.fromEntries(
    [...active, ...done.filter((o) => o.created_at.slice(0, 10) === today)].map((o) => [`m:${o.code}`, { status: o.status, rider: '', info: o.vendor_name }]),
  ),
  ...Object.fromEntries(
    available.map((o) => [`a:${o.code}`, { status: 'open', rider: '', info: `${o.vendor_name} to ${area(o)}. You earn ${money(o.delivery_fee)}` }]),
  ),
}).replace(/</g, '\\u003c');
---

<PanelLayout title="Deliveries" refresh={rider.is_online || active.length > 0 ? 20 : 0}>
  <Alert error={error} success={success} />

  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl md:text-3xl font-extrabold tracking-tight">Deliveries</h1>
      <p class="text-sm text-muted mt-1">Hello, {rider.full_name.split(' ')[0]}</p>
      <SoundControls class="mt-3" />
    </div>
    <dl class="flex flex-wrap gap-8">
      <div><dt class="text-[0.8125rem] font-semibold text-muted">Delivered today</dt><dd class="text-xl font-extrabold tabular">{doneToday.length}</dd></div>
      <div><dt class="text-[0.8125rem] font-semibold text-muted">Earned today</dt><dd class="text-xl font-extrabold tabular">{money(earnedToday)}</dd></div>
    </dl>
  </div>

  <!-- Online toggle -->
  <section
    class:list={[
      'mt-6 rounded-2xl border-2 p-5 flex flex-col gap-4',
      rider.is_online ? 'border-success/40 bg-success-soft' : 'border-line bg-raised',
    ]}
    aria-label="Availability"
  >
    <div class="flex items-center gap-3">
      <span class:list={['size-4 rounded-full shrink-0', rider.is_online ? 'bg-success live-dot' : 'bg-faint']}></span>
      <div>
        <p class:list={['text-xl font-extrabold', rider.is_online ? 'text-success' : 'text-ink']}>{rider.is_online ? 'You are ONLINE' : 'You are OFFLINE'}</p>
        <p class="text-[0.9375rem] text-ink-soft">{rider.is_online ? 'New deliveries will show below. Keep this app open.' : 'Tap the button to start getting deliveries.'}</p>
      </div>
    </div>
    {
      rider.is_online ? (
        <form method="post" data-confirm="Go offline?" data-confirm-message="You'll stop receiving new requests. Deliveries you already accepted stay with you." data-confirm-label="Go offline">
          <input type="hidden" name="action" value="offline" />
          <button type="submit" class="btn btn-secondary btn-lg w-full">Go offline</button>
        </form>
      ) : (
        <form method="post">
          <input type="hidden" name="action" value="online" />
          <button type="submit" class="btn btn-primary btn-lg w-full">Go online</button>
        </form>
      )
    }
  </section>

  <p class="mt-3 text-sm text-muted flex flex-wrap items-center gap-x-2">
    Need help on the road?
    <a href={`tel:${SITE.supportPhone}`} class="font-bold text-danger">Call support now</a>
  </p>

  <div class="mt-6 grid gap-6 lg:grid-cols-2 items-start">
    <!-- My deliveries -->
    <section aria-labelledby="mine-h" class="flex flex-col gap-3">
      <h2 id="mine-h" class="text-[0.9375rem] font-extrabold">Your deliveries ({active.length})</h2>
      {active.length === 0 && <p class="text-sm text-muted p-4 rounded-[0.875rem] border border-dashed border-line-strong">Deliveries you accept show here with pickup and drop-off details.</p>}
      {
        active.map((o) => {
          const cashToCollect = o.payment_method === 'cash' && o.payment_status !== 'paid';
          return (
            <article class="card p-4 flex flex-col gap-4 border-brand ring-[3px] ring-brand-soft">
              <div class="flex justify-between items-baseline gap-3">
                <span class="text-[1.0625rem] font-extrabold tabular">{o.code}</span>
                <span class="text-sm font-bold text-ink tabular">You earn {money(o.delivery_fee)}</span>
              </div>

              <ol class="flex flex-col gap-3">
                <li class="flex gap-3">
                  <span class:list={['size-7 rounded-full flex items-center justify-center shrink-0', o.status === 'picked_up' ? 'bg-success text-paper' : 'bg-ink text-paper']}>
                    {o.status === 'picked_up' ? <Icon name="check" size={14} strokeWidth={3} /> : <Icon name="store" size={14} />}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-semibold text-muted">Pick up from</p>
                    <p class="font-bold">{o.vendor_name}</p>
                    <p class="text-sm text-muted">{o.vendor_address}</p>
                    <p class="text-sm font-semibold mt-1">
                      {o.status === 'ready' && <span class="text-success">Food is ready</span>}
                      {(o.status === 'accepted' || o.status === 'preparing') && <span class="text-warning-ink">Still being prepared</span>}
                      {o.status === 'picked_up' && <span class="text-muted">Picked up</span>}
                    </p>
                  </div>
                  <a href={`tel:${o.vendor_phone}`} class="icon-btn shrink-0" aria-label={`Call ${o.vendor_name}`}><Icon name="phone" size={18} /></a>
                </li>
                <li class="flex gap-3">
                  <span class="size-7 rounded-full bg-brand text-on-brand flex items-center justify-center shrink-0"><Icon name="pin" size={14} /></span>
                  <div class="flex-1 min-w-0">
                    <p class="text-xs font-semibold text-muted">Deliver to</p>
                    <p class="font-bold">{o.delivery_landmark}</p>
                    <p class="text-sm text-muted">{[o.delivery_address, o.locality_name, o.zone_name].filter(Boolean).join(', ')}</p>
                    <p class="text-sm text-muted tabular">{prettyPhone(o.customer_phone)}</p>
                  </div>
                  <a href={`tel:${o.customer_phone}`} class="icon-btn shrink-0" aria-label="Call the customer"><Icon name="phone" size={18} /></a>
                </li>
              </ol>

              <div class="flex justify-between items-center gap-3 p-3 rounded-lg bg-paper text-sm">
                <span>{((n) => `${n} ${n === 1 ? 'item' : 'items'}`)(o.items.reduce((n, i) => n + i.quantity, 0))}</span>
                {cashToCollect ? (
                  <span class="font-extrabold text-warning-ink tabular">Collect {money(o.total)} cash</span>
                ) : (
                  <span class="font-semibold text-muted">Already paid</span>
                )}
              </div>

              {o.status === 'ready' && (
                <form method="post">
                  <input type="hidden" name="action" value="picked_up" />
                  <input type="hidden" name="code" value={o.code} />
                  <button type="submit" class="btn btn-primary btn-lg w-full">I've picked up the food</button>
                </form>
              )}
              {(o.status === 'accepted' || o.status === 'preparing') && (
                <div class="flex flex-col gap-2">
                  <p class="flex items-center justify-center gap-2 h-12 rounded-xl bg-fill text-ink-soft font-bold"><span class="size-2.5 rounded-full bg-star live-dot"></span> The food is being cooked</p>
                  <form
                    method="post"
                    data-confirm="Do you have the food?"
                    data-confirm-message="Only if the restaurant has already handed it to you. The customer will see you're on the way."
                    data-confirm-label="Yes, I have it"
                  >
                    <input type="hidden" name="action" value="picked_up" />
                    <input type="hidden" name="code" value={o.code} />
                    <button type="submit" class="btn btn-secondary btn-lg w-full">I have the food now</button>
                  </form>
                </div>
              )}
              {o.status === 'picked_up' && o.delivery_code_attempts < MAX_CODE_ATTEMPTS && (
                <form method="post" class="flex flex-col gap-2">
                  <input type="hidden" name="action" value="delivered" />
                  <input type="hidden" name="code" value={o.code} />
                  <label for={`pin-${o.code}`} class="field-label mb-0">Customer's delivery code</label>
                  <p class="text-[0.8125rem] text-muted -mt-1">
                    Hand over the food{cashToCollect ? ` and collect ${money(o.total)}` : ''}, then ask the customer for the 4-digit code on their order page.
                  </p>
                  <div class="flex gap-2">
                    <input
                      id={`pin-${o.code}`}
                      name="customer_code"
                      inputmode="numeric"
                      autocomplete="off"
                      maxlength="4"
                      pattern="[0-9]{4}"
                      required
                      class="field-input text-center text-2xl font-bold tracking-[0.4em] tabular w-36"
                      placeholder="0000"
                    />
                    <button type="submit" class="btn btn-primary btn-lg flex-1">Confirm delivery</button>
                  </div>
                  {o.delivery_code_attempts > 0 && (
                    <p class="text-[0.8125rem] font-semibold text-danger">{MAX_CODE_ATTEMPTS - o.delivery_code_attempts} tries left.</p>
                  )}
                </form>
              )}
              {o.status === 'picked_up' && o.delivery_code_attempts >= MAX_CODE_ATTEMPTS && (
                <div class="notice p-3 rounded-lg bg-danger-soft text-danger text-sm">
                  <p class="font-semibold">Too many wrong codes. Call support so we can confirm with the customer.</p>
                  <a href={`tel:${SITE.supportPhone}`} class="btn btn-danger mt-2">Call support</a>
                </div>
              )}
              <button type="button" class="btn btn-ghost text-ink-soft self-start -ml-2" data-report={o.code}>
                <Icon name="alert" size={18} /> Report a problem
              </button>
            </article>
          );
        })
      }
    </section>

    <!-- Requests -->
    <section aria-labelledby="req-h" class="flex flex-col gap-3">
      <h2 id="req-h" class="text-[0.9375rem] font-extrabold">Delivery requests ({available.length})</h2>
      {!rider.is_online && <p class="text-sm text-muted p-4 rounded-[0.875rem] border border-dashed border-line-strong">Go online to see delivery requests.</p>}
      {rider.is_online && active.length >= 2 && <p class="text-sm text-muted p-4 rounded-[0.875rem] border border-dashed border-line-strong">Finish a delivery to take more. You can carry up to 2 at a time.</p>}
      {rider.is_online && active.length < 2 && available.length === 0 && <p class="text-sm text-muted p-4 rounded-[0.875rem] border border-dashed border-line-strong">No requests right now. New ones appear here automatically.</p>}
      {
        available.map((o) => (
          <article class="card p-4 flex flex-col gap-3">
            <div class="flex justify-between items-baseline gap-3">
              <span class="font-extrabold">{o.vendor_name}</span>
              <span class="text-sm font-bold text-ink tabular">Earn {money(o.delivery_fee)}</span>
            </div>
            <div class="text-sm flex flex-col gap-1">
              <span class="flex items-center gap-2"><Icon name="store" size={16} class="text-muted" /> {o.vendor_address}</span>
              <span class="flex items-center gap-2"><Icon name="pin" size={16} class="text-muted" /> {[o.delivery_landmark, o.locality_name, o.zone_name].filter(Boolean).join(', ')}</span>
            </div>
            <div class="flex justify-between items-center text-sm">
              <span class:list={['badge h-6 text-xs', o.status === 'ready' ? 'bg-success-soft text-success' : 'bg-warning-soft text-warning-ink']}>
                {o.status === 'ready' ? 'Ready now' : `Preparing, ${minutesSince(o.created_at)} min`}
              </span>
              <span class="text-muted">{o.payment_method === 'cash' ? `Cash ${money(o.total)}` : 'Paid online'}</span>
            </div>
            <form method="post">
              <input type="hidden" name="action" value="accept" />
              <input type="hidden" name="code" value={o.code} />
              <button type="submit" class="btn btn-primary w-full">Accept delivery</button>
            </form>
          </article>
        ))
      }
    </section>
  </div>
  <dialog id="report-dialog" class="sheet" aria-labelledby="report-title">
    <form method="post" class="p-6 flex flex-col gap-4">
      <input type="hidden" name="action" value="report" />
      <input type="hidden" name="code" />
      <div>
        <h2 id="report-title" class="text-lg font-extrabold">Report a problem</h2>
        <p class="text-sm text-muted mt-1" data-report-for></p>
      </div>
      <div>
        <label for="report-category" class="field-label">What's wrong?</label>
        <select id="report-category" name="category" class="field-input">
          {ISSUE_CATEGORIES.rider.map((c) => <option>{c}</option>)}
        </select>
      </div>
      <div>
        <label for="report-message" class="field-label">Details <span class="text-muted font-medium">(optional)</span></label>
        <textarea id="report-message" name="message" rows="3" class="field-input" maxlength="600"></textarea>
      </div>
      <p class="text-[0.8125rem] text-muted">If anything happens on the road or you feel unsafe, call <a href={`tel:${SITE.supportPhone}`} class="font-bold text-ink">support</a> straight away.</p>
      <div class="flex gap-3">
        <button type="button" data-close class="btn btn-secondary flex-1">Back</button>
        <button type="submit" class="btn btn-primary flex-1">Send report</button>
      </div>
    </form>
  </dialog>
  <script type="application/json" id="rider-snapshot" set:html={snapshot}></script>
</PanelLayout>

<script>
  import { announce, collectAlerts, type Snapshot } from '../../lib/panel-alerts';

  // ---- Alerts: new requests, food ready, cancellations, deliveries from support ----
  const snap = JSON.parse(document.getElementById('rider-snapshot')?.textContent || '{}') as Snapshot;
  const alerts = collectAlerts('rb_rider_snap', snap, (key, before, after, previous) => {
    const code = key.slice(2);
    if (key.startsWith('a:')) return before ? null : { tone: 'new', text: `New delivery request ${code}: ${after.info}.` };
    if (!before) {
      // Not taken from the request list on this page, so support assigned it
      return previous[`a:${code}`] || !['accepted', 'preparing', 'ready'].includes(after.status)
        ? null
        : { tone: 'new', text: `Support gave you ${code} from ${after.info}. Check the details below.` };
    }
    if (after.status === 'ready' && before.status !== 'ready') return { tone: 'new', text: `Food for ${code} is ready at ${after.info}. Go and collect it.` };
    if (after.status === 'cancelled') return { tone: 'warn', text: `${code} was cancelled. Don't collect it. If you already have the food, call support.` };
    return null;
  });
  announce(alerts);

  const dialog = document.getElementById('report-dialog') as HTMLDialogElement;
  const form = dialog.querySelector('form')!;
  document.querySelectorAll<HTMLButtonElement>('[data-report]').forEach((btn) =>
    btn.addEventListener('click', () => {
      form.reset();
      (form.elements.namedItem('code') as HTMLInputElement).value = btn.dataset.report ?? '';
      dialog.querySelector('[data-report-for]')!.textContent = btn.dataset.report ? `About order ${btn.dataset.report}. Support will call you.` : '';
      dialog.showModal();
    }),
  );
</script>
